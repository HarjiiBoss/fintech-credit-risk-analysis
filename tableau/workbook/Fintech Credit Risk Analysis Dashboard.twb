              <text column='[federated.0l6wklt0usoimd1as64wt0mplcod].[usr:Calculation_5018263532867594:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>High-Dependency, Low-Income Segment</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>Borrowers with 3–4 dependents in the lowest income quartile defaulted at </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'><![CDATA[<[federated.0l6wklt0usoimd1as64wt0mplcod].[usr:Calculation_5018263532867594:qk]>]]></run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'> (n = 1,638), more than twice the </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>7.60%</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'> rate of income-matched borrowers with no dependents.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>The </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>5+</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'> dependents × </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>Q2</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'> segment recorded a higher rate (</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>17.9%</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>), but its smaller sample (n = 151) makes the </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>3–4 </run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>dependents × </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>Q1</run>
