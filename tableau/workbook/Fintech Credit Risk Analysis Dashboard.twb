      <table>
        <view>
          <datasources>
            <datasource caption='Borrower Master' name='federated.0l6wklt0usoimd1as64wt0mplcod' />
            <datasource caption='P1 - High Risk Profile' name='federated.1h25h3e1pzxy4819fw1kw17xls45' />
