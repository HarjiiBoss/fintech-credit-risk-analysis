                <zone forceUpdate='true' h='12667' id='9' type-v2='text' w='44875' x='1000' y='82000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#d4af37' fontsize='12'>Insight</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Exposure signals can be distorted by placeholder utilization values and missing-income debt ratios.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Borrowers with unscorable exposure still showed a 5.6% default rate and should remain a monitored segment.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Exposure tiers separated default rates by ~6.1× even among Low behavioral-risk borrowers.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='5' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius-bottom-left' value='0' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius-bottom-right' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='12667' id='1' type-v2='text' w='44813' x='45875' y='82000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#d4af37' fontsize='12'>Recommendation</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Investigate anomalous exposure values before removing them.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Monitor missing-income borrowers separately rather than excluding them.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Combine behavioral risk and exposure signals in underwriting decisions.</run>
                  </formatted-text>
