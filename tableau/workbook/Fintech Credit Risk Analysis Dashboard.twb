      <aliases enabled='yes' />
      <column caption='Population' datatype='integer' name='[Calculation_4492009568403456]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='Overall Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_4492009573072897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([SeriousDlqin2yrs])' />
      </column>
      <column caption='Critical Risk Borrowers' datatype='integer' name='[Calculation_4492009573761026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [risk_tier] = &quot;Critical&quot;&#10;THEN 1&#10;END&#10;)' />
      </column>
      <column caption='Critical Exposure Borrowers' datatype='integer' name='[Calculation_4492009574035459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [exposure_tier] = &quot;Critical&quot;&#10;THEN 1&#10;END&#10;)' />
      </column>
      <column caption='Highest Combined Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_4492009574240260]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='AVG(&#10;IF [risk_tier] = &quot;Critical&quot; AND [exposure_tier] = &quot;Critical&quot;&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='Critical Risk Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263522209792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [risk_tier] = &quot;Critical&quot; THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Highest Risk Segment Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263523590145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [age_band] = &quot;30s&quot; AND [income_quartile] = &quot;Q1 (Lowest)&quot;&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='Strongest Early-Warning Signal' datatype='real' default-format='p0.0%' name='[Calculation_5018263526354946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [delinquency_data_error_flag] = TRUE THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Critical Exposure Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263527006211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [exposure_tier] = &quot;Critical&quot; THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Low Exposure Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263527817220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [exposure_tier] = &quot;Low&quot; THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Invalid Utilization Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263529656325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [utilization_extreme_flag] = TRUE&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='Low Risk, High Exposure Rate' datatype='real' name='[Calculation_5018263530344454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [risk_tier] = &quot;Low&quot; AND [exposure_tier] = &quot;High&quot; THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Low Risk, Low Exposure Rate' datatype='real' name='[Calculation_5018263530586119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [risk_tier] = &quot;Low&quot; AND [exposure_tier] = &quot;Low&quot; THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Exposure Spread Within Low Risk Tier' datatype='real' default-format='n&quot;~&quot;#,##0.0&quot;x&quot;;-&quot;~&quot;#,##0.0&quot;x&quot;' name='[Calculation_5018263530766344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5018263530344454] / [Calculation_5018263530586119]' />
      </column>
      <column caption='Zero Credit Line Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_5018263532085257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [NumberOfOpenCreditLinesAndLoans] = 0&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='High Dependency Segment ' datatype='real' default-format='p0.0%' name='[Calculation_5018263532867594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [NumberOfDependents] &gt;= 3 AND [NumberOfDependents] &lt;= 4&#10;AND [income_quartile] = &quot;Q1 (Lowest)&quot;&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='Average Default Age' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5018263533350923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [SeriousDlqin2yrs] = 1&#10;THEN [age]&#10;END&#10;)' />
      </column>
      <column caption='Zero Lines Default Rate' datatype='real' name='[Calculation_5018263534166028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [NumberOfOpenCreditLinesAndLoans] = 0 THEN [SeriousDlqin2yrs] END)' />
      </column>
      <column caption='Safest Credit Line Band Rate' datatype='real' name='[Calculation_5018263534301197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [NumberOfOpenCreditLinesAndLoans] &gt;= 8 AND [NumberOfOpenCreditLinesAndLoans] &lt;= 15&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
      </column>
      <column caption='Thin-File Risk Multiplier' datatype='real' default-format='n&quot;~&quot;#,##0.0&quot;x&quot;;-&quot;~&quot;#,##0.0&quot;x&quot;' name='[Calculation_5018263534817294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5018263534166028] / [Calculation_5018263534301197]' />
      </column>
      <column caption='Critical_Matrix_Tooltip_Note' datatype='string' name='[Calculation_5018264015052818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [risk_tier] = &quot;Critical&quot; AND [exposure_tier] = &quot;Critical&quot; THEN &#10;&quot;Note: 55.0% default rate — the highest observed rate in the Risk × Exposure matrix. This compares with 47.1% for Critical behavioral risk overall and 22.4% for Critical exposure overall.&quot;&#10;ELSE &quot;&quot; &#10;END' />
      </column>
      <column caption='Exposure_Index_Calculation_Tooltip_Note' datatype='string' name='[Calculation_5018264017399828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exposure_tier] = &quot;Indeterminate&quot; THEN &#10;&quot;Note: Monthly income was missing, so an Exposure Index score could not be assigned.&quot;&#10;ELSE &quot;&quot; &#10;END' />
      </column>
      <column caption='Population Share' datatype='real' default-format='p0.0%' name='[Calculation_5018264019628053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4492009568403456]) / TOTAL([Calculation_4492009568403456])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age_20s_Tooltip_Note' datatype='string' name='[Calculation_5018264021389334]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age_band] = &quot;20s&quot; THEN &#10;&quot;Note: Borrowers in their 20s have the highest observed default rate at 11.7%, approximately 3.8× the 3.1% rate among borrowers aged 60+.&quot;&#10;ELSE &quot;&quot; &#10;END' />
      </column>
      <column caption='Income-missing Empirical Rate' datatype='integer' default-format='p0.0%' name='[Calculation_5018264094863383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [exposure_tier] = &quot;Indeterminate (income missing)&quot; THEN [SeriousDlqin2yrs] END' />
      </column>
      <column caption='Delinquency_Data_Error_Tooltip_Note' datatype='string' name='[Calculation_5018264233664536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delinquency_data_error_flag] = TRUE THEN&#10;&quot;Insight: 269 borrowers (0.18%) carry placeholder delinquency codes (96/98), not genuine payment counts. This data-quality artifact showed the strongest observed default signal in the analysis and was investigated rather than discarded.&quot;&#10;ELSE&#10;&quot;&quot;&#10;END' />
      </column>
      <column caption='Low_Risk_Exposure_Note' datatype='string' name='[Calculation_5018264247459866]' role='dimension' type='nominal'>
