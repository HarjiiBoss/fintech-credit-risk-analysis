                <zone forceUpdate='true' h='12667' id='9' type-v2='text' w='44875' x='1000' y='82000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#d4af37' fontsize='12'>Insight</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Exposure signals can be distorted by placeholder utilization values and missing-income debt ratios.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Borrowers with unscorable exposure still showed a 5.6% default rate and should remain a monitored segment.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#a9b4c2'>• </run>
                    <run fontcolor='#a9b4c2' fontname='Google Sans Text'>Exposure tiers separated default rates by ~6.1× even among Low behavioral-risk borrowers.</run>
