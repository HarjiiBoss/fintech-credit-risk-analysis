          <datasource-dependencies datasource='federated.0l6wklt0usoimd1as64wt0mplcod'>
            <column caption='Highest Combined Default Rate' datatype='real' default-format='p0.0%' name='[Calculation_4492009574240260]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='AVG(&#10;IF [risk_tier] = &quot;Critical&quot; AND [exposure_tier] = &quot;Critical&quot;&#10;THEN [SeriousDlqin2yrs]&#10;END&#10;)' />
